{
  "name": "trading-executions-iceberg-sink",
  "config": {
    "connector.class": "com.snowflake.kafka.connector.SnowflakeStreamingSinkConnector",
    "tasks.max": "1",
    "topics": "trading.executions.v1",
    "snowflake.topic2table.map": "trading.executions.v1:TRADE_EVENTS_LANDING",
    "buffer.count.records": "100",
    "buffer.flush.time": "10",
    "buffer.size.bytes": "5000000",
    "snowflake.url.name": "<ACCOUNT_IDENTIFIER>.snowflakecomputing.com:443",
    "snowflake.user.name": "<SERVICE_USER>",
    "snowflake.private.key": "<YOUR_RSA_PRIVATE_KEY_BASE64>",
    "snowflake.role.name": "<YOUR_ROLE>",
    "snowflake.database.name": "BRONZE",
    "snowflake.schema.name": "TRADING",
    "snowflake.ingestion.method": "SNOWPIPE_STREAMING",
    "snowflake.streaming.iceberg.enabled": "true",
    "snowflake.enable.schematization": "true",
    "snowflake.autocreate.table.type": "snowflake",
    "snowflake.validation": "server_side",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "snowflake.streaming.validate.compatibility.with.classic": "false",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "trading.executions.dlq",
    "errors.deadletterqueue.topic.replication.factor": "1"
  }
}