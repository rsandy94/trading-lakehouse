# Snowflake connection for the Dagster sensor/object check (definitions.py)
SNOWFLAKE_USER=<SERVICE_USER>
SNOWFLAKE_PRIVATE_KEY_PATH=<ABSOLUTE_PATH_TO_PROJECT>\keys\rsa_key.p8
# Only needed if rsa_key.p8 is encrypted
SNOWFLAKE_KEY_PASSWORD=
SNOWFLAKE_ACCOUNT=<ACCOUNT_IDENTIFIER>
SNOWFLAKE_ROLE=<YOUR_ROLE>
SNOWFLAKE_WAREHOUSE=<YOUR_WAREHOUSE>

# dbt project locations (defaults already hardcoded in definitions.py)
DBT_PROJECT_DIR=<PATH_TO_DBT_PROJECT>
DBT_PROFILES_DIR=<PATH_TO_DBT_PROFILES>
