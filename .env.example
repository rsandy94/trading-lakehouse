# Snowflake connection for the Dagster sensor/object check (definitions.py)
SNOWFLAKE_USER=<SERVICE_USER>
SNOWFLAKE_PRIVATE_KEY_PATH=<ABSOLUTE_PATH_TO_PROJECT>\keys\rsa_key.p8
# Only needed if rsa_key.p8 is encrypted
SNOWFLAKE_KEY_PASSWORD=
SNOWFLAKE_ACCOUNT=<ACCOUNT_IDENTIFIER>
# Use a least-privilege role (no ACCOUNTADMIN)
SNOWFLAKE_ROLE=<YOUR_ROLE>
SNOWFLAKE_WAREHOUSE=<YOUR_WAREHOUSE>

# dbt project locations. DBT_PROJECT_DIR is required; DBT_PROFILES_DIR defaults to ~/.dbt
DBT_PROJECT_DIR=<PATH_TO_TRADING_LAKEHOUSE_DBT_CHECKOUT>
DBT_PROFILES_DIR=<PATH_TO_DBT_PROFILES>

# Quarantine asset check: fail when less than this % of the latest batch passes
QUARANTINE_PASS_RATE_THRESHOLD_PCT=98.0
# Optional: Slack incoming webhook that receives check-failure alerts
ALERT_WEBHOOK_URL=
